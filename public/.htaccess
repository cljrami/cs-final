RewriteEngine On

# Detectar bots sociales para servir versión PHP con OG server-side
SetEnvIf User-Agent "facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|Pinterest|TelegramBot|Discordbot|Googlebot" is_social_bot

# Redirigir www
RewriteCond %{HTTP_HOST} ^consexvip\.cl$ [NC]
RewriteRule ^(.*)$ https://www.consexvip.cl/$1 [R=301,L]

# Antiguo anunciate -> publicidad
RewriteRule ^anunciate/?$ /publicidad/ [R=301,L]

# Antiguo publicar -> registro de escort
RewriteRule ^publicar/?$ /micuenta/registro/ [R=301,L]

# Paginas PHP
RewriteRule ^publicidad/?$ publicidad/index.html [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]
# Sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# Negocios ahora es Astro -> sin rewrite a PHP
RewriteRule ^negocio/([0-9]+)?$ negocio.php?id=$1 [L,QSA]

# Escorts
# Servir versión PHP con OG server-side para bots sociales
RewriteCond %{ENV:is_social_bot} 1
RewriteRule ^cs(\d+)/?$ escort.php?id=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cs(\d+)/?$ /perfil/?id=$1 [L,QSA]

# Redirect antigua ruta numérica 106 a nueva ruta cs106
RewriteRule ^106/?$ /cs106/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(\d+)/?$ escort.php?id=$1 [L,QSA]
RewriteCond %{DOCUMENT_ROOT}/ciudad/$1/index.html -f
RewriteRule ^escorts-([a-z0-9-]+)/?$ /ciudad/$1/index.html [L,QSA]
RewriteRule ^escorts-([a-z0-9-]+)/?$ /ciudad-fallback.php?slug=$1 [L,QSA]

# Error
ErrorDocument 404 /404.html

# Seguridad
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
Header always set Strict-Transport-Security "max-age=31536000"

# Cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

<FilesMatch "\.(css|js|woff2|woff|ttf|svg|webp|jpg|jpeg|png)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

<FilesMatch "\.(html)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </IfModule>
</FilesMatch>
