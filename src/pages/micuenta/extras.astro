---
import EscortLayout from "../../layouts/EscortLayout.astro";
import EscortSidebar from "../../components/escort/EscortSidebar";
import EscortAuthGuard from "../../components/escort/EscortAuthGuard";
import ExtrasPlan from "../../components/escort/ExtrasPlan";
import AprobacionRequerida from "../../components/escort/AprobacionRequerida";
---

<EscortLayout title="Extras Al Plan- CS Panel" activePage="extras">
  <EscortSidebar slot="sidebar" activePage="extras" client:load />

  <EscortAuthGuard client:load>
    <div class="w-full max-w-full">
      <AprobacionRequerida client:load>
        <ExtrasPlan client:load />
      </AprobacionRequerida>
    </div>
  </EscortAuthGuard>
</EscortLayout>
