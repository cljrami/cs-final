---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Iniciar Sesión - CS Panel">
  <div
    class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#0f0f1a] to-[#1a1a2e]"
  >
    <div
      class="w-full max-w-md mx-4 bg-admin-card rounded-2xl p-8 md:p-10"
    >
      <div class="text-center mb-8">
        <div
          class="w-16 h-16 bg-gradient-to-br from-red-500 to-red-600 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-4"
        >
          <i class="fas fa-user text-white"></i>
        </div>
        <h1 class="text-2xl font-bold mb-2 text-white">CS Panel</h1>
        <p class="text-admin-muted text-sm">
          Acceso para escorts
        </p>
      </div>

      <form id="loginForm" class="space-y-5">
        <div>
          <label class="block text-sm text-admin-muted mb-2">
            <i class="fas fa-user mr-2"></i>Usuario
          </label>
          <div
            class="flex items-center bg-[#0f0f1a] rounded-xl px-4 focus-within:bg-[#2a2a3e] transition-colors"
          >
            <i class="fas fa-user text-gray-500"></i>
            <input
              type="text"
              id="usuario"
              class="flex-1 bg-transparent border-none text-white px-4 py-3 outline-none"
              placeholder="Tu usuario"
              required
            />
          </div>
        </div>

        <div>
          <label class="block text-sm text-admin-muted mb-2">
            <i class="fas fa-lock mr-2"></i>Contraseña
          </label>
          <div
            class="flex items-center bg-[#0f0f1a] rounded-xl px-4 focus-within:bg-[#2a2a3e] transition-colors"
          >
            <i class="fas fa-lock text-gray-500"></i>
            <input
              type="password"
              id="password"
              class="flex-1 bg-transparent border-none text-white px-4 py-3 outline-none"
              placeholder="••••••••"
              required
            />
          </div>
        </div>

        <button
          type="submit"
          id="submitBtn"
          class="w-full bg-gradient-to-r from-red-500 to-red-600 text-white py-3 rounded-xl font-bold flex items-center justify-center gap-2 hover:opacity-90 transition-opacity cursor-pointer"
        >
          <i class="fas fa-sign-in-alt"></i>
          <span>Iniciar Sesión</span>
        </button>
      </form>

      <div
        id="error"
        class="hidden text-red-500 text-center mt-4 text-sm bg-red-500/10 border border-red-500/20 rounded-lg p-3"
      >
        <i class="fas fa-exclamation-circle mr-2"></i>
        <span id="errorText"></span>
      </div>

      <p class="text-center mt-4 text-gray-500 text-sm">
        ¿No tienes cuenta?
        <a href="/micuenta/registro" class="text-red-400 hover:text-red-300 transition-colors">Regístrate aquí</a>
      </p>

      <p class="text-center mt-2 text-gray-500 text-sm">
        <a href="/micuenta/recuperar" class="text-admin-muted hover:text-white transition-colors">
          <i class="fas fa-key mr-2"></i>¿Olvidaste tu contraseña?
        </a>
      </p>

      <p class="text-center mt-2 text-gray-500 text-sm">
        <a href="/" class="text-admin-muted hover:text-white transition-colors">
          <i class="fas fa-arrow-left mr-2"></i>Volver al sitio
        </a>
      </p>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    const form = document.getElementById("loginForm");
    const usuarioInput = document.getElementById("usuario");
    const passwordInput = document.getElementById("password");
    const errorDiv = document.getElementById("error");
    const errorText = document.getElementById("errorText");
    const submitBtn = document.getElementById("submitBtn");

    if (!form || !usuarioInput || !passwordInput || !errorDiv || !errorText) {
      console.error("Form elements not found");
      return;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorDiv.classList.add("hidden");

      const usuario = usuarioInput.value.trim();
      const password = passwordInput.value;

      if (!usuario || !password) {
        errorText.textContent = "Completa todos los campos";
        errorDiv.classList.remove("hidden");
        return;
      }

      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML =
        '<i class="fas fa-spinner fa-spin"></i> Entrando...';
      submitBtn.disabled = true;

      try {
        const response = await fetch("/api/escort/login.php", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ usuario, password }),
        });

        const text = await response.text();

        let data;
        try {
          data = JSON.parse(text);
        } catch (e) {
          throw new Error("Respuesta no es JSON: " + text.substring(0, 100));
        }

        if (data.success) {
          localStorage.setItem("escort_token", data.token);
          localStorage.setItem("escort_data", JSON.stringify(data.escort));
          if (data.primerLogin === 1) {
            window.location.replace("/micuenta/onboarding");
          } else {
            window.location.replace("/micuenta/resumen");
          }
        } else {
          errorText.textContent = data.error || "Credenciales incorrectas";
          errorDiv.classList.remove("hidden");
        }
      } catch (err) {
        console.error("Error:", err);
        errorText.textContent = err.message || "Error de conexión";
        errorDiv.classList.remove("hidden");
      } finally {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    });
  })();
</script>
