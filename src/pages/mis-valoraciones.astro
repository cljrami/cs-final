---
import UserLayout from "../layouts/UserLayout.astro";
---
<UserLayout title="Mis Valoraciones" activePage="valoraciones">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-white flex items-center gap-3">
      <i class="fas fa-star text-amber-400"></i>Mis Valoraciones
    </h1>
  </div>

  <div id="loading" class="text-center py-16">
    <i class="fas fa-spinner fa-spin text-amber-400 text-2xl"></i>
    <p class="text-gray-500 text-sm mt-3">Cargando valoraciones...</p>
  </div>

  <div id="noAuth" class="hidden text-center py-16">
    <i class="fas fa-user-lock text-4xl text-gray-600 mb-4"></i>
    <p class="text-gray-500 mb-4">Debes iniciar sesión</p>
    <a href="/ingresar" class="inline-flex items-center gap-2 px-6 py-3 bg-red-500 text-white rounded-xl font-semibold">Iniciar Sesión</a>
  </div>

  <div id="empty" class="hidden text-center py-16">
    <i class="fas fa-star text-4xl text-gray-600 mb-3 opacity-30"></i>
    <p class="text-gray-500">No has dejado valoraciones aún</p>
    <a href="/" class="text-red-400 text-sm mt-2 inline-block hover:text-red-300">Explorar escorts</a>
  </div>

  <div id="list" class="hidden space-y-4"></div>
  <div id="comentarios-section" class="hidden mt-10">
    <h3 class="text-white font-semibold mb-4 flex items-center gap-2">
      <i class="fas fa-comments text-red-500"></i> Mis Comentarios
    </h3>
    <div id="comentarios-lista" class="space-y-4"></div>
  </div>
</UserLayout>

<script is:inline>
(function() {
  const token = localStorage.getItem('usuario_token');
  const userDataRaw = localStorage.getItem('usuario_data');
  if (!token || !userDataRaw) {
    document.getElementById('loading').classList.add('hidden');
    document.getElementById('noAuth').classList.remove('hidden');
    return;
  }
  const userId = JSON.parse(userDataRaw).id;

  Promise.all([
    fetch('/api/escorts/valorar.php?usuario_id=' + userId, {
      headers: { 'Authorization': 'Bearer ' + token }
    }).then(r => r.json()),
    fetch('/api/comentarios/listar.php?usuario_id=' + userId, {
      headers: { 'Authorization': 'Bearer ' + token }
    }).then(r => r.json()).catch(() => ({ success: false }))
  ])
  .then(([valData, comData]) => {
    document.getElementById('loading').classList.add('hidden');
    const list = document.getElementById('list');

    var items = [];

    if (valData.success && valData.valoraciones) {
      valData.valoraciones.forEach(v => {
        items.push({ type: 'valoracion', data: v });
      });
    }

    if (comData.success && comData.comentarios) {
      comData.comentarios.forEach(c => {
        items.push({ type: 'comentario', data: c });
      });
    }

    if (items.length === 0) {
      document.getElementById('empty').classList.remove('hidden');
      return;
    }

    list.classList.remove('hidden');
    items.forEach(function(item) {
      const card = document.createElement('div');
      card.className = 'bg-[#1a1a2e] border border-white/5 rounded-xl p-4';
      if (item.type === 'valoracion') {
        const v = item.data;
        const stars = Array.from({length: 5}, (_, i) => `<i class="fas fa-star ${i < v.general ? 'text-amber-400' : 'text-gray-700'} text-xs"></i>`).join('');
        card.innerHTML = `
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">Valoración</span>
              <strong class="text-white text-sm">${v.escort_nombre || 'Escort'}</strong>
              <span class="text-gray-600 text-xs ml-auto">${v.fecha ? new Date(v.fecha).toLocaleDateString('es-CL') : ''}</span>
            </div>
            <div class="flex items-center gap-1 mb-2">${stars}</div>
            <p class="text-gray-400 text-sm">${v.comentario || 'Sin comentario'}</p>
          </div>
        `;
      } else {
        const c = item.data;
        card.innerHTML = `
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20">Comentario</span>
              <strong class="text-white text-sm">${c.escort_nombre || 'Escort'}</strong>
              <span class="text-gray-600 text-xs ml-auto">${c.created_at ? new Date(c.created_at).toLocaleDateString('es-CL') : ''}</span>
            </div>
            ${c.puntuacion ? '<div class="flex items-center gap-1 mb-2">' + Array.from({length: c.puntuacion}, () => '<i class="fas fa-star text-yellow-400 text-xs"></i>').join('') + '</div>' : ''}
            <p class="text-gray-400 text-sm">${c.comentario}</p>
          </div>
        `;
      }
      list.appendChild(card);
    });
  })
  .catch(() => {
    document.getElementById('loading').classList.add('hidden');
    document.getElementById('empty').classList.remove('hidden');
  });
})();
</script>
