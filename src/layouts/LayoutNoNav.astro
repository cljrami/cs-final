---
import "../styles/global.css";
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
 <head>
   <meta charset="UTF-8" />
   <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   <title>{title || "Consexvip"}</title>
   <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
      .fancybox__container { align-items: center; justify-content: center; }
      .fancybox__content { display: flex; align-items: center; justify-content: center; height: 100vh; }
      .fancybox__image { object-fit: contain; max-height: 100vh; max-width: 100vw; }
    </style>
  </head>
<body class="bg-page text-ink antialiased">
  <slot />
</body>
</html>
