# Copiar este archivo como .env y completar los valores reales
# NUNCA subir .env al repositorio

# Base de datos
DB_HOST=localhost
DB_NAME=kimi_app
DB_USER=kimi_app
DB_PASS=COMPLETAR_CONTRASENA_SEGURA
DB_CHARSET=utf8mb4

# Secreto para firmar tokens (generar con: openssl rand -hex 32)
APP_SECRET=COMPLETAR_SECRETO_LARGO_Y_ALEATORIO

# Entorno
APP_ENV=production
