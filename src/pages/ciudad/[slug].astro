---
// src/pages/ciudad/[slug].astro
// Página SEO por ciudad: /escorts-{slug} → ciudad/{slug}/index.html
// La URL pública /escorts-{slug} se resuelve vía .htaccess a esta página estática.
import Layout from "../../layouts/Layout.astro";
import CiudadEscorts from "../../components/CiudadEscorts";

interface Ciudad {
  slug: string;
  nombre: string;
}

export async function getStaticPaths() {
  function slugify(nombre: string): string {
    return nombre
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }
  const SOURCES = [
    "https://www.consexvip.cl/api/ciudades/listado.php",
  ];
  let ciudades: Ciudad[] = [];
  for (const src of SOURCES) {
    try {
      const res = await Promise.race([
        fetch(src),
        new Promise((_, reject) => setTimeout(() => reject(new Error("timeout")), 8000)),
      ]);
      const raw = await res.text();
      // Eliminar UTF-8 BOM si está presente
      const cleaned = raw.startsWith('\uFEFF') ? raw.slice(1) : raw;
      const data = JSON.parse(cleaned);
      if (data.success && Array.isArray(data.data) && data.data.length > 0) {
        ciudades = data.data
          .filter((c: any) => c && c.nombre)
          .map((c: any) => ({
            slug: c.slug || slugify(c.nombre),
            nombre: c.nombre,
          }));
        break;
      }
    } catch (e) {}
  }
  return ciudades.map((c) => ({ params: { slug: c.slug }, props: { ciudadNombre: c.nombre, slug: c.slug } }));
}

const { ciudadNombre, slug } = Astro.props as { ciudadNombre: string; slug: string };

// Título y descripción SEO específicos por ciudad
const tituloCiudad = `Escorts en ${ciudadNombre}`;
const tituloH1 = `Escorts en ${ciudadNombre}`;
const descCiudad = `Encuentra escorts verificadas en ${ciudadNombre}. Perfiles con fotos, tarifas y contacto directo. Reserva con seguridad.`;
---

<Layout title={tituloCiudad} description={descCiudad} page="ciudad" vars={{ ciudad: ciudadNombre }} canonical={`/escorts-${slug}`} indexable>
  <main class="min-h-screen bg-page">
    {/* H1 estático: Google lo lee sin ejecutar JS */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <nav class="flex items-center gap-2 text-sm text-muted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-red-400 transition-colors">Inicio</a>
        <span class="text-gray-700">/</span>
        <a href="/ciudades" class="hover:text-red-400 transition-colors">Ciudades</a>
        <span class="text-gray-700">/</span>
        <span class="text-gray-400" aria-current="page">{ciudadNombre}</span>
      </nav>
      <h1 class="text-2xl md:text-3xl font-bold text-ink flex items-center gap-3">
        <i class="fas fa-map-marker-alt text-red-400"></i>{tituloH1}
      </h1>
    </div>
    <CiudadEscorts client:only="react" ciudadInicial={ciudadNombre} />
  </main>
</Layout>
