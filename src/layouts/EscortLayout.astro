---
// src/layouts/EscortLayout.astro
import "@fortawesome/fontawesome-free/css/fontawesome.min.css";
import "../styles/fa-fontfaces.css";
import EscortSidebar from "../components/escort/EscortSidebar";
import NotificationBell from "../components/escort/NotificationBell";

interface Props {
  title: string;
  activePage?: string;
}

const { title, activePage = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>{title} | Panel Escort</title>
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="bg-escort-bg text-escort-text antialiased overflow-x-hidden">
    <!-- Sidebar: siempre visible, hidratado como React -->
    <EscortSidebar client:load activePage={activePage} />

    <!-- Contenido principal: SIN margen en móvil, CON margen solo en lg+ -->
    <main
      class="lg:ml-[260px] min-h-screen flex flex-col transition-all duration-300"
    >
      <!-- Header sticky -->
      <header
        class="bg-escort-card border-b border-escort-border px-4 sm:px-6 py-4 flex justify-between items-center sticky top-0 z-40 backdrop-blur-sm bg-opacity-95"
      >
        <!-- Lado izquierdo: breadcrumb con padding para el botón hamburguesa en móvil -->
        <div
          class="text-sm text-escort-muted flex items-center min-w-0 flex-1 pr-4"
        >
          <!-- En móvil: dejar espacio para el botón hamburguesa del sidebar (≈48px) -->
          <span class="lg:hidden w-10 flex-shrink-0"></span>

          <div class="flex items-center min-w-0">
            <i class="fas fa-user-shield mr-2 text-red-500 flex-shrink-0"></i>
            <span class="hidden sm:inline flex-shrink-0">Escort</span>
            <span class="hidden sm:inline mx-2 text-escort-border flex-shrink-0"
              >›</span
            >
            <span class="text-escort-text font-medium truncate">{title}</span>
          </div>
        </div>

        <!-- Lado derecho: acciones -->
        <div class="flex gap-2 sm:gap-3 items-center flex-shrink-0">
          <NotificationBell client:load />
          <a
            href="/"
            target="_blank"
            class="bg-transparent border border-escort-border text-escort-muted w-9 h-9 sm:w-10 sm:h-10 rounded-lg hover:text-escort-text hover:border-escort-muted transition-all duration-200 flex items-center justify-center"
            aria-label="Ver sitio"
          >
            <i class="fas fa-external-link-alt text-sm sm:text-base"></i>
          </a>
        </div>
      </header>

      <!-- Contenido de la página -->
      <div class="p-4 sm:p-6 lg:p-8 flex-1 animate-fadeIn">
        <slot />
      </div>
    </main>
  <!-- Admin acting-as banner -->
  <div id="admin-acting-banner" class="hidden fixed top-0 left-0 right-0 z-50 bg-red-600 text-white text-center py-2 px-4 text-sm font-medium">
    Editando como administrador — <span id="acting-escort-name">...</span>
    <button id="acting-exit" class="ml-4 bg-white text-red-600 px-3 py-0.5 rounded text-xs font-bold hover:bg-red-50 transition-colors">Salir</button>
  </div>

  <script>
    (function() {
      var params = new URLSearchParams(window.location.search);
      var adminToken = params.get('admin_token');
      var escortId = params.get('escort_id');

      if (adminToken && escortId) {
        // Guardar token anterior para restaurar
        var prev = localStorage.getItem('token');
        if (prev) sessionStorage.setItem('prev_escort_token', prev);

        // Sobrescribir con token de admin
        localStorage.setItem('token', adminToken);
        sessionStorage.setItem('acting_as', escortId);

        // Mostrar banner
        var banner = document.getElementById('admin-acting-banner');
        if (banner) {
          (async function() {
            try {
              var r = await fetch('/api/admin/escorts.php?id=' + escortId, {
                headers: { Authorization: 'Bearer ' + adminToken }
              });
              var d = await r.json();
              var name = d.data && d.data.nombre ? d.data.nombre : ('#' + escortId);
              document.getElementById('acting-escort-name').textContent = name;
            } catch(e) {
              document.getElementById('acting-escort-name').textContent = '#' + escortId;
            }
          })();
          banner.classList.remove('hidden');
          // Ajustar padding al body
          document.body.style.paddingTop = '40px';
        }

        // Salir: restaurar token y recargar
        document.getElementById('acting-exit').addEventListener('click', function() {
          var prev = sessionStorage.getItem('prev_escort_token');
          if (prev) {
            localStorage.setItem('token', prev);
          } else {
            localStorage.removeItem('token');
          }
          sessionStorage.removeItem('acting_as');
          window.location.href = '/admin/escorts';
        });

        // Override global fetch para añadir acting_as a todas las requests
        var origFetch = window.fetch;
        window.fetch = function(url, opts) {
          var a = sessionStorage.getItem('acting_as');
          if (a) {
            var sep = url.indexOf('?') !== -1 ? '&' : '?';
            url = url + sep + 'acting_as=' + a;
          }
          return origFetch.call(this, url, opts);
        };

        // Restaurar al cerrar/recargar
        window.addEventListener('beforeunload', function() {
          var prev = sessionStorage.getItem('prev_escort_token');
          if (prev) {
            localStorage.setItem('token', prev);
          } else {
            localStorage.removeItem('token');
          }
        });
      }
    })();
  </script>
</body>
</html>

<style is:global>
  @import "tailwindcss";

  @theme {
    --color-black: #000000;
    --color-white: #ffffff;
    --color-escort-bg: #0a0a0f;
    --color-escort-card: #13131a;
    --color-escort-border: #2d2d44;
    --color-escort-text: #ffffff;
    --color-escort-muted: #9ca3af;
    --color-escort-accent: #ef4444;
  }

  body {
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      sans-serif;
    background-color: #0a0a0f;
    color: #ffffff;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
    src: url('/fonts/inter-latin-variable.woff2') format('woff2');
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fadeIn {
    animation: fadeIn 0.4s ease-out;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #0a0a0f;
  }
  ::-webkit-scrollbar-thumb {
    background: #2d2d44;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #3d3d5c;
  }

  /* Safe area para móviles con notch */
  @supports (padding-top: env(safe-area-inset-top)) {
    .safe-top {
      padding-top: env(safe-area-inset-top);
    }
  }

  [draggable="true"]:active {
    cursor: grabbing;
  }
</style>
