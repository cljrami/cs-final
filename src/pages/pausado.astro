---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Perfil pausado" showNavFooter={false} page="pausado">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-page to-surface">
    <div class="w-full max-w-md mx-4 bg-admin-card rounded-2xl p-8 md:p-10 text-center">
      <div class="w-24 h-24 bg-amber-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <i class="fas fa-pause-circle text-amber-400 text-3xl"></i>
      </div>
      
      <h1 class="text-2xl font-bold text-ink mb-3">Perfil pausado</h1>
      <p class="text-muted mb-6">Esta escort ha pausado temporalmente su anuncio.</p>
      
      <div class="bg-surface border border-white/5 rounded-xl p-6 mb-6 text-left">
        <h3 class="text-ink font-semibold mb-4 flex items-center gap-2">
          <i class="fas fa-info-circle text-amber-400"></i> ¿Qué significa esto?
        </h3>
        <ul class="text-muted text-sm space-y-2">
          <li class="flex items-center gap-2">
            <i class="fas fa-check text-amber-400 text-xs"></i>
            El perfil no es visible en los listados ni búsquedas
          </li>
          <li class="flex items-center gap-2">
            <i class="fas fa-check text-amber-400 text-xs"></i>
            La escort puede reactivarlo cuando quiera desde su panel
          </li>
          <li class="flex items-center gap-2">
            <i class="fas fa-check text-amber-400 text-xs"></i>
            Sus datos, fotos y configuración se conservan intactos
          </li>
          <li class="flex items-center gap-2">
            <i class="fas fa-check text-amber-400 text-xs"></i>
            No pierde antigüedad ni valoraciones
          </li>
        </ul>
      </div>
      
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-red-500 text-white rounded-xl font-semibold hover:bg-red-600 transition-all w-full justify-center">
        <i class="fas fa-home"></i> Volver al inicio
      </a>
    </div>
  </div>
</Layout>
