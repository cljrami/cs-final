---
import UserLayout from "../layouts/UserLayout.astro";
---
<UserLayout title="Mis Comentarios" activePage="comentarios">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-white flex items-center gap-3">
      <i class="fas fa-comments text-red-400"></i>Mis Comentarios
    </h1>
  </div>

  <div id="loading" class="flex items-center justify-center h-64">
    <div class="w-10 h-10 border-4 border-red-500 border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div id="noAuth" class="hidden text-center py-16">
    <i class="fas fa-user-lock text-4xl text-gray-600 mb-4"></i>
    <p class="text-gray-500 mb-4">Debes iniciar sesión</p>
    <a href="/ingresar" class="inline-flex items-center gap-2 px-6 py-3 bg-red-500 text-white rounded-xl font-semibold">Iniciar Sesión</a>
  </div>

  <div id="empty" class="hidden text-center py-16">
    <i class="fas fa-comment-slash text-4xl text-gray-600 mb-3 opacity-30"></i>
    <p class="text-gray-500">No has dejado comentarios aún</p>
    <a href="/" class="text-red-400 text-sm mt-2 inline-block hover:text-red-300">Explorar escorts</a>
  </div>

  <div id="list" class="hidden space-y-4"></div>

  <!-- Confirm Modal -->
  <div id="confirmModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70">
    <div class="bg-[#1a1a2e] border border-[#2a2a3e] rounded-xl w-full max-w-sm">
      <div class="p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-exclamation-triangle text-red-400 text-lg"></i>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm" id="modalTitle">Confirmar</h3>
            <p class="text-gray-400 text-sm leading-relaxed mt-0.5" id="modalMessage"></p>
          </div>
        </div>
        <div class="flex justify-end gap-3">
          <button id="modalCancel" class="px-4 py-2 bg-[#2a2a3e] hover:bg-[#353550] text-gray-300 rounded-lg text-sm font-medium transition-colors">Cancelar</button>
          <button id="modalConfirm" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition-colors">Confirmar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Alert Modal -->
  <div id="alertModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70">
    <div class="bg-[#1a1a2e] border border-[#2a2a3e] rounded-xl w-full max-w-sm">
      <div class="p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-info-circle text-blue-400 text-lg"></i>
          </div>
          <div>
            <h3 class="text-white font-semibold text-sm">Información</h3>
            <p class="text-gray-400 text-sm leading-relaxed mt-0.5" id="alertMessage"></p>
          </div>
        </div>
        <div class="flex justify-end gap-3">
          <button id="alertConfirm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">Entendido</button>
        </div>
      </div>
    </div>
  </div>
</UserLayout>

<script is:inline>
(function() {
  const token = localStorage.getItem("usuario_token");
  const userDataRaw = localStorage.getItem("usuario_data");
  if (!token || !userDataRaw) {
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("noAuth").classList.remove("hidden");
    return;
  }
  const userId = JSON.parse(userDataRaw).id;

  fetch("/api/escorts/valorar.php?usuario_id=" + userId, {
    headers: { "Authorization": "Bearer " + token }
  })
  .then(r => r.json())
  .then(data => {
    document.getElementById("loading").classList.add("hidden");
    if (!data.success || !data.valoraciones || data.valoraciones.length === 0) {
      document.getElementById("empty").classList.remove("hidden");
      return;
    }
    const list = document.getElementById("list");
    list.classList.remove("hidden");

    data.valoraciones.forEach(function(v) {
      if (!v.comentario) return;
      const card = document.createElement("div");
      card.className = "bg-[#1a1a2e] border border-white/5 rounded-xl p-4";
      var escortAvatar = v.escort_foto
        ? '<img src="' + v.escort_foto + '" alt="" class="w-8 h-8 rounded-full object-cover" loading="lazy" onerror="this.style.display=\'none\'" />'
        : '<div class="w-8 h-8 rounded-full bg-[#2a2a3e] flex items-center justify-center"><i class="fas fa-user text-gray-600 text-xs"></i></div>';
      card.innerHTML =
        "<div class=\"flex items-center justify-between mb-2\">" +
          "<div class=\"flex items-center gap-2\">" +
            "<span class=\"text-[10px] px-1.5 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20\">Comentario</span>" +
            escortAvatar +
            "<strong class=\"text-white text-sm\">" + (v.escort_nombre || "Escort") + "</strong>" +
          "</div>" +
        "</div>" +
        "<p class=\"text-gray-300 text-sm leading-relaxed\">" + v.comentario + "</p>" +
        "<div class=\"flex items-center justify-between mt-3 pt-3 border-t border-white/5\">" +
          "<span class=\"text-gray-600 text-xs\">" + (v.fecha ? new Date(v.fecha).toLocaleDateString("es-CL") : "") + "</span>" +
          "<button onclick=\"confirmEliminarComentario(" + v.id + ")\" class=\"text-xs text-red-400 hover:text-red-300 bg-red-500/10 hover:bg-red-500/20 px-2 py-0.5 rounded transition-colors\">" +
            "<i class=\"fas fa-trash-alt mr-1\"></i>Eliminar" +
          "</button>" +
        "</div>";
      list.appendChild(card);
    });

    if (list.children.length === 0) {
      document.getElementById("empty").classList.remove("hidden");
      list.classList.add("hidden");
    }
  })
  .catch(function() {
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("empty").classList.remove("hidden");
  });
})();

let pendingDeleteId = null;

function confirmEliminarComentario(id) {
  pendingDeleteId = id;
  document.getElementById("modalMessage").textContent = "¿Eliminar este comentario? No se puede deshacer.";
  document.getElementById("confirmModal").classList.remove("hidden");
}

document.getElementById("modalCancel").addEventListener("click", function() {
  document.getElementById("confirmModal").classList.add("hidden");
  pendingDeleteId = null;
});

document.getElementById("modalConfirm").addEventListener("click", function() {
  if (pendingDeleteId === null) return;
  const id = pendingDeleteId;
  pendingDeleteId = null;
  document.getElementById("confirmModal").classList.add("hidden");
  eliminarComentario(id);
});

document.getElementById("alertConfirm").addEventListener("click", function() {
  document.getElementById("alertModal").classList.add("hidden");
});

function showAlert(message) {
  document.getElementById("alertMessage").textContent = message;
  document.getElementById("alertModal").classList.remove("hidden");
}

function eliminarComentario(id) {
  const token = localStorage.getItem("usuario_token");
  fetch("/api/escorts/valorar.php", {
    method: "DELETE",
    headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
    body: JSON.stringify({ id: id })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.success) {
      window.location.reload();
    } else {
      showAlert(data.error || "Error al eliminar");
    }
  })
  .catch(function() {
    showAlert("Error al eliminar el comentario");
  });
}
</script>