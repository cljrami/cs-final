---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Buscar Escorts">
  <main style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="font-size: 2rem; margin-bottom: 2rem;">🔍 Buscar Escorts</h1>

    <!-- Filtros -->
    <div
      style="background: var(--bg-secondary); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem;"
    >
      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;"
      >
        <input
          type="text"
          placeholder="Ciudad..."
          style="background: var(--bg-primary); border: 1px solid var(--border); color: var(--text-primary); padding: 0.875rem; border-radius: 8px; font-size: 1rem; outline: none;"
          onfocus="this.style.borderColor='var(--accent)'"
          onblur="this.style.borderColor='var(--border)'"
        />
        <select
          style="background: var(--bg-primary); border: 1px solid var(--border); color: var(--text-primary); padding: 0.875rem; border-radius: 8px; font-size: 1rem; outline: none; cursor: pointer;"
        >
          <option value="">Edad</option>
          <option value="18-25">18-25 años</option>
          <option value="26-35">26-35 años</option>
          <option value="36-45">36-45 años</option>
          <option value="46+">46+ años</option>
        </select>
        <select
          style="background: var(--bg-primary); border: 1px solid var(--border); color: var(--text-primary); padding: 0.875rem; border-radius: 8px; font-size: 1rem; outline: none; cursor: pointer;"
        >
          <option value="">Servicios</option>
          <option value="todos">Todos</option>
          <option value="social">Cita social</option>
          <option value="relax">Masajes</option>
          <option value="premium">Premium</option>
        </select>
        <button
          style="background: var(--accent); color: #000; border: none; padding: 0.875rem; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 1rem; transition: all 0.2s;"
          onmouseover="this.style.background='var(--accent-hover)'"
          onmouseout="this.style.background='var(--accent)'">Buscar</button
        >
      </div>
    </div>

    <!-- Resultados placeholder -->
    <div
      style="text-align: center; padding: 4rem; color: var(--text-secondary);"
    >
      <div style="font-size: 3rem; margin-bottom: 1rem;">🔧</div>
      <p style="font-size: 1.1rem;">Filtros avanzados en construcción</p>
      <p style="font-size: 0.9rem; margin-top: 0.5rem;">
        Pronto podrás buscar con todos los filtros
      </p>
    </div>
  </main>
</Layout>
