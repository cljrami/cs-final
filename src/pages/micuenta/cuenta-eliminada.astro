---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Cuenta Eliminada - CS Panel">
  <div class="min-h-screen bg-page flex items-center justify-center py-12 px-4">
    <div class="w-full max-w-lg">
      <div class="bg-admin-card rounded-2xl p-8 md:p-10 border border-admin-border">
        <div class="text-center mb-8">
          <div class="w-16 h-16 bg-gradient-to-br from-red-500 to-red-700 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-red-500/20">
            <i class="fas fa-trash-alt text-ink text-2xl"></i>
          </div>
          <h1 class="text-2xl font-bold text-ink">Cuenta Eliminada</h1>
          <p class="text-muted text-sm mt-2">
            Tu cuenta fue eliminada de la plataforma
          </p>
          <p id="cuentaEmail" class="text-admin-muted text-sm mt-1"></p>
        </div>

        <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 mb-6">
          <p class="text-admin-muted text-sm leading-relaxed">
            <i class="fas fa-info-circle mr-2 text-red-400"></i>
            Tu cuenta ya no se encuentra activa y no puedes iniciar sesión con ella.
          </p>
        </div>

        <div class="space-y-4 mb-8">
          <div class="flex items-start gap-3 bg-page rounded-xl p-4">
            <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center flex-shrink-0">
              <i class="fas fa-undo text-emerald-400"></i>
            </div>
            <div>
              <h3 class="text-ink font-semibold text-sm mb-1">Puedes volver a publicar</h3>
              <p class="text-admin-muted text-sm leading-relaxed">
                Para recuperar tu anuncio, regístrate nuevamente con tu mismo email: tu cuenta
                se reactivará automáticamente y podrás contratar un nuevo plan.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3 bg-page rounded-xl p-4">
            <div class="w-10 h-10 rounded-full bg-yellow-500/20 flex items-center justify-center flex-shrink-0">
              <i class="fas fa-exclamation-triangle text-yellow-400"></i>
            </div>
            <div>
              <h3 class="text-ink font-semibold text-sm mb-1">Tu plan gratuito ya fue usado</h3>
              <p class="text-admin-muted text-sm leading-relaxed">
                Al reactivar tu cuenta, el plan gratuito de 7 días no estará disponible para este
                email, por lo que deberás seleccionar un plan de pago para publicar tu anuncio.
              </p>
            </div>
          </div>
        </div>

        <a href="/micuenta/registro"
          class="w-full bg-gradient-to-r from-red-500 to-red-600 text-white py-3 rounded-xl font-bold flex items-center justify-center gap-2 hover:opacity-90 transition-opacity">
          <i class="fas fa-user-plus"></i>
          Crear cuenta nuevamente
        </a>

        <p class="text-center mt-4 text-muted text-sm">
          <a href="/micuenta/login" class="text-admin-muted hover:text-ink transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>Volver a iniciar sesión
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const email = params.get("email");
    const el = document.getElementById("cuentaEmail");
    if (el && email) {
      el.innerHTML = '<i class="fas fa-envelope mr-2 text-muted"></i>' + document.createTextNode(email).nodeValue;
    }
  })();
</script>
