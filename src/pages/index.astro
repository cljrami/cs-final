---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import HomeEscorts from '../components/HomeEscorts';
import MasValoradas from '../components/MasValoradas';
import CTASection from '../components/CTASection';
import HeroContent from '../components/HeroContent';
import HistoriasCiudad from '../components/HistoriasCiudad';

let heroCfg: Record<string, string> | null = null;
try {
  const res = await fetch("http://localhost/api/config/site.php");
  const data = await res.json();
  if (data.success) heroCfg = data.data;
} catch (e) {}
if (!heroCfg || !heroCfg.hero_titulo) {
  try {
    const res = await fetch("https://kimi.zona8.cl/api/config/site.php");
    const data = await res.json();
    if (data.success) heroCfg = data.data;
  } catch (e) {}
}
---

<Layout title="Inicio" page="inicio">
  <main class="min-h-screen bg-page">
    {/* Hero */}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-red-950/20 via-transparent to-transparent"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-red-500/5 rounded-full blur-3xl"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 pt-16 pb-10 text-center">
        <HeroContent client:load initialCfg={heroCfg} />
      </div>
    </section>

    {/* Contenedor principal + sidebar */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row gap-6">
      <div class="flex-1 min-w-0">
        {/* Historias (todas) */}
        <HistoriasCiudad client:load />

        {/* Escorts - React Component */}
        <HomeEscorts client:load />

        {/* Más valoradas */}
        <MasValoradas client:visible />

        {/* CTA Publica tu anuncio */}
        <div class="py-8">
          <CTASection client:visible />
        </div>
      </div>

    <div class="h-16"></div>
  </main>
</Layout>
