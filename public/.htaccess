RewriteEngine On

# Error 404
ErrorDocument 404 /404.html

# ============================================
# SEGURIDAD - Cabeceras globales
# ============================================
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# ============================================
# CRÍTICO: Pasar Authorization header a PHP
# ============================================
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# ============================================
# PREFLIGHT - Solo para API (204 = No Content)
# ============================================
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [R=204,L]

# ============================================
# ROBOTS.TXT → robots.php (gestionado desde admin)
# ============================================
RewriteRule ^robots\.txt$ robots.php [L,QSA]

# ============================================
# ARCHIVOS/CARPETAS EXISTENTES - No redirigir
# ============================================
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ============================================
# API - No redirigir
# ============================================
RewriteRule ^api/ - [L]

# ============================================
# ADMIN - No redirigir
# ============================================
RewriteRule ^admin/ - [L]

# ============================================
# RUTAS NUMÉRICAS (/8, /123) → escort.php?id=8
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(\d+)/?$
RewriteRule ^(\d+)/?$ escort.php?id=$1 [L,QSA]

# ============================================
# SITEMAP.XML → sitemap.php
# ============================================
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# ============================================
# CIUDAD /{slug} → ciudad/index.html
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ciudad/([^/]+)/?$ ciudad/index.html [L,QSA]

# ============================================
# PÁGINAS ASTRO - Servir HTML estático si existe
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L]

# Si nada coincide → 404
RewriteRule ^(.*)$ - [R=404,L]