---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Página no encontrada" showNavFooter={false} page="404">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-page to-surface">
    <div class="w-full max-w-md mx-4 bg-admin-card rounded-2xl p-8 md:p-10 text-center">
      <div class="w-24 h-24 bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <i class="fas fa-compass text-red-400 text-3xl"></i>
      </div>
      
      <h1 class="text-3xl font-bold text-ink mb-3">404</h1>
      <h2 class="text-xl text-muted mb-4">Página no encontrada</h2>
      <p class="text-muted mb-8">Lo sentimos, la página que buscas no existe o ha sido movida.</p>
      
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-red-500 text-white rounded-xl font-semibold hover:bg-red-600 transition-all">
        <i class="fas fa-home"></i> Volver al inicio
      </a>
    </div>
  </div>
</Layout>
