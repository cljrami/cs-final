---
 // src/pages/ciudades.astro
// Hub de ciudades: lista todas las ciudades con escorts y enlaza a cada
// página /escorts-{slug}. Sirve como linkbuilding interno y evita el 404
// de la URL /ciudades.
import Layout from "../layouts/Layout.astro";
import CiudadesHub from "../components/CiudadesHub";

const titulo = "Escorts por Ciudad en Chile";
const descripcion =
  "Encuentra escorts verificadas en todas las ciudades de Chile. Elige tu ciudad y revisa perfiles con fotos, tarifas y contacto directo.";
---

<Layout title={titulo} description={descripcion} canonical="/ciudades" indexable>
  <main class="min-h-screen bg-page">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <nav class="flex items-center gap-2 text-sm text-muted mb-6">
        <a href="/" class="hover:text-red-400 transition-colors">Inicio</a>
        <span class="text-gray-700">/</span>
        <span class="text-gray-400">Ciudades</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold text-ink mb-3">Escorts por Ciudad</h1>
      <p class="text-muted max-w-2xl mb-10">
        Selecciona tu ciudad para ver los perfiles disponibles: fotos verificadas, tarifas claras y contacto directo.
      </p>

      <CiudadesHub client:load />
    </div>
  </main>
</Layout>
