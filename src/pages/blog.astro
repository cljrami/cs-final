---
import Layout from '../layouts/Layout.astro';
import BlogList from '../components/BlogList';
---

<Layout title="Artículos & Consejos" page="blog" indexable>
  <main class="min-h-screen bg-page">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-ink mb-2">Artículos & Consejos</h1>
      <p class="text-muted">Lecturas, consejos y experiencias de nuestra comunidad.</p>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <BlogList client:load />
    </section>
  </main>
</Layout>
