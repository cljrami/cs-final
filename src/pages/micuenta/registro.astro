---
import Layout from "../../layouts/Layout.astro";
import RegistroWizard from "../../components/escort/RegistroWizard";
---

<Layout title="Registro - CS Panel">
  <div
    class="min-h-screen bg-[#0a0a0f] flex items-center justify-center py-12 px-4"
  >
    <div class="w-full max-w-lg">
      <div class="text-center mb-8">
        <div
          class="w-16 h-16 bg-gradient-to-br from-red-500 to-red-700 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-red-500/20"
        >
          <i class="fas fa-user-plus text-white text-2xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-white">Crear Cuenta</h1>
        <p class="text-gray-500 text-sm mt-1">
          Únete a CS Panel en 2 simples pasos
        </p>
      </div>

      <RegistroWizard client:load />
    </div>
  </div>
</Layout>
